# Frontend configuration. Everything prefixed NEXT_PUBLIC_ is compiled into the browser bundle,
# so never put secrets here. Razorpay, Gemini, JWT and database secrets live ONLY in the backend .env.

# Public base URL of the backend (no trailing slash, without /api/v1). Must be an origin listed in the
# backend's FRONTEND_URL allow-list for CORS, and same-site with this frontend so auth cookies are sent.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Socket.IO URL (defaults to NEXT_PUBLIC_API_BASE_URL)
NEXT_PUBLIC_SOCKET_URL=

# Optional server-only URL used by server components to reach the API over a private network
# (e.g. http://api:4000 inside Docker). Defaults to NEXT_PUBLIC_API_BASE_URL.
API_INTERNAL_URL=

# Server-only shared secret for POST /api/revalidate (the backend calls it after admin publishes).
# Must equal the backend's REVALIDATE_SECRET (32+ random chars). Never prefix it with NEXT_PUBLIC_.
REVALIDATE_SECRET=

# Public URL of this site (canonical links, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Brand shown in the header/footer. The backend's settings.store values (support email/phone) are
# loaded at runtime from /api/v1/settings/public.
NEXT_PUBLIC_STORE_NAME=Decor Dice
NEXT_PUBLIC_STORE_TAGLINE=Maison of Fine Living

# Optional links. Footer/social entries are hidden when empty.
NEXT_PUBLIC_INSTAGRAM_HANDLE=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_PINTEREST_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_TERMS_URL=

# Extra image hosts (comma-separated hostnames) for product images on another CDN / bucket
NEXT_PUBLIC_EXTRA_IMAGE_HOSTS=
